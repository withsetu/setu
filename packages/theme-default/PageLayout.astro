---
import Layout from './Layout.astro'
import type { PageLayoutProps } from '@setu/core'
// The theme contract's props for this component (packages/core/src/theme/layout-props.ts).
type Props = PageLayoutProps
const { title, lang, themeOptions, siteSettings, feedLocales, seo } = Astro.props
---
<Layout title={title} lang={lang} themeOptions={themeOptions} siteSettings={siteSettings} feedLocales={feedLocales} seo={seo}>
  <article class="prose measure-page"><slot /></article>
</Layout>
