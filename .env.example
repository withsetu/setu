# Staging-profile overrides for `pnpm staging` (#869). Copy to `.env` (untracked) to change a
# value — the script's built-in defaults are exactly the values below, so copying this file
# verbatim changes nothing. Precedence: script defaults < .env. Shell exports are ignored for
# these knobs. Every value here is public and zero-secret; real secrets (e.g. a live Resend
# key) belong in your untracked `.env` only — never in this file, never committed.

# Email: deliver through the Mailpit sink `pnpm staging` starts (loopback-only, no auth).
SETU_EMAIL_ADAPTER=smtp
SETU_SMTP_HOST=127.0.0.1
SETU_SMTP_PORT=11026

# From-address for password-reset and forms-notification emails (an address, not a secret;
# without one the api keeps email disabled).
SETU_FORMS_NOTIFY_FROM=staging@setu.localhost

# Cloudflare Turnstile public TEST keys — every challenge auto-resolves, they protect nothing,
# and the api boot log flags them loudly as TEST KEYS. Explanation + the other documented
# dummy keys: apps/api/README.md → "Captcha in dev — Turnstile test keys (#868)".
SETU_CAPTCHA_PROVIDER=turnstile
SETU_TURNSTILE_SITE_KEY=1x00000000000000000000AA
SETU_TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Caddy's front ports. 443/80 give the clean port-less origins; if another stack on your
# machine permanently owns them (Docker Desktop, DDEV, a local nginx), pick free ones — every
# staging origin then carries the suffix (e.g. https://admin.setu.localhost:8443).
SETU_STAGING_HTTPS_PORT=443
SETU_STAGING_HTTP_PORT=80

# Session-signing secret: auto-generated per staging sandbox when unset (persisted at
# .content-sandbox/staging/.setu/staging/auth-secret, wiped by `pnpm content:reset staging`).
# Uncomment only to pin your own value — in your untracked .env, never here.
# SETU_AUTH_SECRET=

# ---------------------------------------------------------------------------------------
# `pnpm dev` behind a reverse proxy or tunnel (#1049)
# ---------------------------------------------------------------------------------------
# Every value below is a DEFAULT that `pnpm dev` falls back to, not a constant — export any
# of them (or set them in your untracked .env) and the dev script uses yours instead. They
# only need changing when the browser is NOT on the same machine as the dev servers: a
# tunnel, a reverse proxy, Codespaces port forwarding, or a container. The commented values
# are exactly what `pnpm dev` uses when unset, so uncommenting them verbatim changes nothing.
#
# These are baked into the admin bundle when the dev server starts, so a browser elsewhere
# resolving `localhost:4444` would hit ITS OWN machine, not the API.
# VITE_SETU_API=http://localhost:4444
# VITE_SETU_SITE=http://localhost:4321
# SETU_API_URL=http://localhost:4444
# PUBLIC_SETU_MEDIA=http://localhost:4444
#
# The API's credentialed CORS allowlist. Already env-driven (see
# apps/api/src/auth/allowed-origins.ts) and defaults to the admin dev server in local mode,
# but a non-loopback admin origin must be named here or cookie-bearing requests fail.
# SETU_ADMIN_ORIGIN=http://localhost:5173
#
# Extra hostnames the dev servers accept in the `Host` header, comma-separated. Unset means
# loopback only, which is the safe default — Vite's host check is what defends the dev
# server against DNS rebinding. Widening it stays enumerable on purpose: `true` and `*` are
# refused rather than accepted (scripts/dev-allowed-hosts.mjs).
# SETU_DEV_ALLOWED_HOSTS=admin.example.com,site.example.com

# ---------------------------------------------------------------------------------------
# Dev-server ports and the content sandbox (#1051)
# ---------------------------------------------------------------------------------------
# All three dev servers now refuse a busy port rather than quietly moving to the next one.
# A moved admin still has VITE_SETU_API baked into its bundle, so it would talk to another
# worktree's api while the dev badge claims otherwise; behind a proxy pinned to one port it is
# a silent misroute. Recover from "port in use" with `pnpm dev:stop`.
# SETU_API_PORT=4444
# SETU_ADMIN_PORT=5173
# SETU_SITE_PORT=4321
#
# Which content sandbox `pnpm dev` runs against. Defaults to this checkout's own
# .content-sandbox/dev, which means every worktree is a separate Setu install with its own auth
# DB — and therefore its own first-account bootstrap (#1053). Point several worktrees at one
# path to share a single bootstrapped sandbox, or give each its own clone:
#
#     pnpm content:clone dev my-branch
#     SETU_REPO_DIR=/abs/path/to/.content-sandbox/my-branch
#
# A clone carries the auth DB, so the account travels with it, while each branch keeps its own
# database and cannot leave another branch's schema ahead of it.
# SETU_REPO_DIR=/abs/path/to/.content-sandbox/dev
# SETU_CONTENT_DIR=/abs/path/to/.content-sandbox/dev/content
