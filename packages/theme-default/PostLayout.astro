---
import Layout from './Layout.astro'
import RelatedReading from './RelatedReading.astro'
import type { PostLayoutProps } from '@setu/core'

// The theme contract's props for this component (packages/core/src/theme/layout-props.ts).
type Props = PostLayoutProps
const { title, lang, themeOptions, siteSettings, related = [], feedLocales, heading = 'Read Next', showImage = true, seo } = Astro.props
---

<Layout title={title} lang={lang} themeOptions={themeOptions} siteSettings={siteSettings} feedLocales={feedLocales} seo={seo}>
  <slot name="hero" />
  <article class="prose measure-post"><slot /></article>
  <div class="measure-post"><RelatedReading related={related} heading={heading} showImage={showImage} /></div>
</Layout>
