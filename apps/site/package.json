{
  "name": "@setu/site",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "predev": "node ../../scripts/gen-blocks.mjs && node ../../scripts/gen-relations.mjs",
    "dev": "astro dev",
    "prebuild": "node ../../scripts/gen-blocks.mjs && node ../../scripts/gen-relations.mjs && node ../../scripts/gen-redirects.mjs",
    "build": "astro build",
    "genrelations": "node ../../scripts/gen-relations.mjs",
    "genredirects": "node ../../scripts/gen-redirects.mjs",
    "test": "vitest run",
    "typecheck": "node ../../scripts/gen-blocks.mjs && node ../../scripts/gen-relations.mjs && astro sync && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/markdoc": "2.0.6",
    "@astrojs/react": "6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@setu/blocks": "workspace:*",
    "@setu/core": "workspace:*",
    "@setu/image-astro": "workspace:*",
    "@setu/theme-default": "workspace:*",
    "astro": "7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.12.1",
    "jsdom": "^25.0.1",
    "purgecss": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
