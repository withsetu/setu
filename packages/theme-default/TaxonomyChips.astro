---
import { taxonomyArchivePath, DEFAULT_LOCALE } from '@setu/core'
interface Props {
  categories: { slug: string; name: string }[]
  tags: string[]
  /** The post's own locale: chips link to THAT locale's archive (`/fr/tag/<slug>/` for a French
   *  post, unprefixed for the default locale), which the site emits for every term carrying ≥1
   *  post in the locale — so a fr-only tag is a real page, never a 404 (#1114). */
  locale?: string
}
const { categories, tags, locale = DEFAULT_LOCALE } = Astro.props
const has = categories.length > 0 || tags.length > 0
// `taxonomyArchivePath` is core's single primitive for an archive URL: Astro's own route-param
// encoding (#→%23, ?→%3F, NOT encodeURIComponent) + the site's trailing-slash spelling, shared with
// the archive routes and the sitemap <loc> so the three are byte-identical (#860 BLOCK-4, #1114).
// 
---

{has && (
  /* `measure-post` is PostLayout's reading-column width class — keeps the chips aligned to the article column. */
  <nav class="setu-taxonomy measure-post" aria-label="Categories and tags">
    {categories.map((c) => (
      <a class="setu-chip setu-chip--cat" href={taxonomyArchivePath('category', c.slug, locale)}>{c.name}</a>
    ))}
    {tags.map((t) => (
      <a class="setu-chip setu-chip--tag" href={taxonomyArchivePath('tag', t, locale)}>#{t}</a>
    ))}
  </nav>
)}

<style>
  .setu-taxonomy { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.75rem 0 0.5rem; }
  .setu-chip {
    display: inline-flex; align-items: center; height: 1.85rem; padding: 0 0.7rem;
    border: 1px solid var(--border, #e5e7eb); border-radius: 999px;
    font-size: 0.85rem; color: var(--text, inherit); text-decoration: none;
    /* --surface-2 is the block token contract's subtle raised-surface fill (--surface was never
       defined, so this silently fell back to transparent). See packages/blocks/src/tokens.css. */
    background: var(--surface-2);
  }
  .setu-chip--cat { font-weight: 600; }
  .setu-chip:hover { border-color: var(--accent, #4f46e5); color: var(--accent, #4f46e5); }
</style>
