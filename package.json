{
  "name": "setu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Open-source, Git-backed, multi-topology CMS engine.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "content:seed": "node scripts/content-sandbox.mjs seed",
    "content:reset": "node scripts/content-sandbox.mjs reset",
    "content:clone": "node scripts/content-sandbox.mjs clone",
    "auth:login-link": "node scripts/auth-login-link.mjs",
    "auth:reset-password": "pnpm --filter @setu/api run auth:reset-password",
    "dev": "node scripts/dev.mjs",
    "dev:status": "node scripts/dev-status.mjs",
    "staging": "node scripts/staging.mjs start",
    "staging:stop": "node scripts/staging.mjs stop",
    "dev:stop": "node scripts/dev.mjs --stop",
    "dev:fresh": "node scripts/free-ports.mjs 4321 4444 5173 && pnpm dev",
    "test": "pnpm -r test",
    "test:turbo": "turbo run test",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "typecheck": "pnpm -r typecheck",
    "typecheck:turbo": "turbo run typecheck",
    "lint": "eslint .",
    "lint:turbo": "turbo run lint && pnpm run lint:root",
    "lint:root": "eslint . --ignore-pattern \"apps/**\" --ignore-pattern \"packages/**\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test -c e2e",
    "e2e:ui": "playwright test -c e2e --ui",
    "e2e:captcha": "playwright test -c e2e/captcha.config.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "auth:create-owner": "pnpm --filter @setu/api run auth:create-owner"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@setu/auth": "workspace:*",
    "@setu/db-sqlite": "workspace:*",
    "@types/node": "^26.4.0",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3",
      "sharp"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-67mh-4wv8-2f99"
      ]
    },
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "js-yaml@4": ">=4.3.1",
      "nanoid@3": ">=3.3.18 <4",
      "shell-quote": ">=1.9.0",
      "svgo": ">=4.0.2",
      "sharp": ">=0.35.0",
      "fast-xml-parser": ">=5.10.1"
    }
  }
}
